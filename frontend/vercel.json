{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "env": {
    "VITE_API_URL": "@paypaddy_api_url",
    "VITE_WS_URL":  "@paypaddy_ws_url"
  }
}
